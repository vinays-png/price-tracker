    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "../.test-build",
    "rootDir": "..",
    "baseUrl": "..",
    "paths": {
      "@/*": [
        "./*"
      ]
    }
